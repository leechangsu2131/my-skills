# 이 예시는 저장소용 문서이며, 실제 값은 OneDrive\96. 인증\google.env에만 둡니다.
# 시작 사이트가 공통이면 한 번만 지정합니다.
GOOGLE_WALLPAPER_START_URL=https://example.org/

# 계정마다 번호를 늘려 이메일·비밀번호를 한 쌍으로 적습니다.
# 실제 이메일과 비밀번호를 이 파일에 넣거나 저장소에 커밋하지 마세요.
GOOGLE_WALLPAPER_ACCOUNT_01_ALIAS=학생A
GOOGLE_WALLPAPER_ACCOUNT_01_EMAIL=student01@example.invalid
GOOGLE_WALLPAPER_ACCOUNT_01_PASSWORD=replace-locally

# 필요할 때만 지정: 기본은 현재 사용자 다운로드 폴더입니다.
# GOOGLE_WALLPAPER_DOWNLOADS_DIR=%USERPROFILE%\Downloads
