{
  "gemini_model": "gemini-2.5-flash",
  "gemini_cli_path": "gemini",
  "output_format": "json",
  "annotation": {
    "correct_mark": "⭕",
    "wrong_mark": "❌",
    "needs_review_mark": "❓",
    "font_name": "helv",
    "font_size": 10,
    "summary_font_size": 12,
    "title_font_size": 16,
    "add_summary_page": true,
    "correct_color": [0, 0.6, 0],
    "wrong_color": [0.8, 0, 0],
    "info_color": [0, 0, 0.6]
  },
  "grading": {
    "case_sensitive": false,
    "strip_whitespace": true,
    "normalize_numbers": true,
    "descriptive_auto_grade": false,
    "fuzzy_ocr_match": true,
    "fuzzy_match_ratio": 0.88,
    "fuzzy_min_length": 2
  },
  "ocr": {
    "auto_pick_page_window": true,
    "student_page_offset": null,
    "flag_alignment_review_below": 0.35,
    "blank_layout_ocr_mode": "anchor_strips",
    "layout_render_dpi": 36,
    "enable_translation_correction": false,
    "render_dpi": 120,
    "highres_render_dpi": 240,
    "min_text_layer_lines_per_page": 4
  },
  "answer_region_detector": {
    "mode": "opencv",
    "weights_path": "",
    "confidence": 0.25,
    "class_aliases": [
      "answer",
      "answer_area",
      "answer_blank",
      "choice_blank",
      "choice_box",
      "choice_answer_region",
      "checkbox",
      "objective_answer",
      "short_answer_line",
      "descriptive_answer_area"
    ]
  },
  "paths": {
    "input_students": "data/input/students",
    "input_answer_key": "data/input/answer_key",
    "extracted": "data/extracted",
    "graded": "data/graded",
    "output": "data/output"
  }
}
