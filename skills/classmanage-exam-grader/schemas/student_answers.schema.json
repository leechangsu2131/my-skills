{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StudentAnswers",
  "description": "Normalized OCR output for one student's exam submission.",
  "type": "object",
  "required": ["student_name", "answers"],
  "properties": {
    "student_name": {
      "type": "string",
      "description": "Student display name."
    },
    "student_number": {
      "type": ["integer", "null"],
      "description": "Optional student number."
    },
    "exam_title": {
      "type": ["string", "null"],
      "description": "Optional exam title."
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q_num", "answer"],
        "properties": {
          "q_num": {
            "type": "integer",
            "description": "Question number."
          },
          "type": {
            "type": "string",
            "enum": ["multiple_choice", "short_answer", "descriptive", "unknown"],
            "description": "Question type."
          },
          "answer": {
            "type": "string",
            "description": "Recognized student answer text."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Normalized OCR confidence bucket."
          },
          "page": {
            "type": ["integer", "null"],
            "description": "1-based page index containing the answer."
          },
          "bbox": {
            "type": ["array", "null"],
            "description": "Bounding box for the detected answer region [x1, y1, x2, y2].",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "requires_review": {
            "type": "boolean",
            "description": "Whether the answer should default to teacher review."
          }
        }
      }
    }
  }
}
