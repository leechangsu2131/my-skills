# Google Sheets target for personal-analyze-trade.
# Copy this file to .env and fill in private/local values.
# .env is ignored by git.
#
# Connector/MCP path:
# - GOOGLE_SHEET_ID is enough for Google Sheets Connector reads/writes.
#
# Local gspread fallback:
# - Fill GOOGLE_SA_* from a Google service account JSON key.
# - Share the target spreadsheet with GOOGLE_SA_CLIENT_EMAIL.

GOOGLE_SHEET_ID=
GOOGLE_SHEET_URL=

GOOGLE_SA_TYPE=service_account
GOOGLE_SA_PROJECT_ID=
GOOGLE_SA_PRIVATE_KEY_ID=
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_CLIENT_ID=
GOOGLE_SA_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SA_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SA_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SA_CLIENT_CERT_URL=
