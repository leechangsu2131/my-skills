# ============================================================
# 당근마켓 자동 수집 시스템 — 환경 설정
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워넣으세요.
# .env 파일은 절대 커밋하지 마세요!
# ============================================================

# === Google Sheets Service Account ===
# service_account.json에서 아래 값들을 복사
GOOGLE_SA_TYPE=service_account
GOOGLE_SA_PROJECT_ID=your-project-id
GOOGLE_SA_PRIVATE_KEY_ID=your-private-key-id
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_SA_CLIENT_ID=000000000000000000000
GOOGLE_SA_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SA_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SA_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SA_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project.iam.gserviceaccount.com

# === Google Sheet ID ===
# 구글시트 URL의 /d/ 뒤에 있는 ID
# https://docs.google.com/spreadsheets/d/【여기가 ID】/edit
GOOGLE_SHEET_ID=

# === Appium 설정 (선택) ===
# 기본값은 config.json에서 관리, 여기서 오버라이드 가능
# APPIUM_HOST=127.0.0.1
# APPIUM_PORT=4723
