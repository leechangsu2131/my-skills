<script type="text/javascript">
//<![CDATA[      


    // 조건 검색
    function searchMessage() {
        var searchForm = nv.$("searchForm");



		var searchText = $("#searchText");
		if(searchText.length > 0) {
        	if(searchText.val() == '') {
        		if(confirm("검색어가 입력되지 않았습니다. 전체 검색 하시겠습니까?")) {
        			searchForm.submit();
        		} else {
        			searchText.focus();
        		}
        	} else {
        		searchForm.submit();
        	}
        } else {
        	searchForm.submit();
        }

    }


    // 전체 검색
    function searchAll(){    
        var searchForm = nv.$("searchForm");
        var startSearchDay = "2000-01-01";
        var endSearchDay = "2026-06-06";
        var startSearchDayArr = startSearchDay.split("-");
        var endSearchDayArr = endSearchDay.split("-");
        
        $("#searchStartYear").getSetSSValue(startSearchDayArr[0]);
        $("#searchStartMonth").getSetSSValue(startSearchDayArr[1]);
        $("#searchStartDay").getSetSSValue(startSearchDayArr[2]);   
        $("#searchEndYear").getSetSSValue(endSearchDayArr[0]);
        $("#searchEndMonth").getSetSSValue(endSearchDayArr[1]);
        $("#searchEndDay").getSetSSValue(endSearchDayArr[2]);            
    }
        
    // 검색 기간 변경
    function chageSearchDay(searchType){
    
        var weekDay = "2026-05-30";
        var monthDay = "2026-05-06";
        var searchDayArr;
        if(searchType == "week")
            searchDayArr = weekDay.split("-");
        else if(searchType == "month")
            searchDayArr = monthDay.split("-");
               
        $("#searchStartYear").getSetSSValue(searchDayArr[0]);
        $("#searchStartMonth").getSetSSValue(searchDayArr[1]);
        $("#searchStartDay").getSetSSValue(searchDayArr[2]);
        
        var endSearchDay = "2026-06-06";
        var endSearchDayArr = endSearchDay.split("-");
        $("#searchEndYear").getSetSSValue(endSearchDayArr[0]);
        $("#searchEndMonth").getSetSSValue(endSearchDayArr[1]);
        $("#searchEndDay").getSetSSValue(endSearchDayArr[2]);
        
    }


    //초기화 - window의 로딩이 느릴경우 너무 느려짐으로 변경함.
	//nv.Event.addListener(window, "load",function() {  
	$(document).ready(function() {
      



        $("#searchType").getSetSSValue("2");




		// 달력 레이아웃, 웹표준에 맞게 변경됨 // 2013.02.28
		$("#date1").click(function() {
			beforeShowDate("datepicker1");
		});
	
		$("#date2").click(function() {
			beforeShowDate("datepicker2");
		});
		
        // calendar layout
        $().datePicker('datepicker1');
        $().datePicker('datepicker2');
        
        // search day
        $("#searchStartYear").getSetSSValue("2025");
        $("#searchStartMonth").getSetSSValue("05");
        $("#searchStartDay").getSetSSValue("04");
        $("#searchEndYear").getSetSSValue("2026");
        $("#searchEndMonth").getSetSSValue("05");
        $("#searchEndDay").getSetSSValue("04");           


    });     
        
//]]>
</script>


<div class="searchbox">
