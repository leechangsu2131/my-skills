	<script type="text/javascript">
	
		//전체메뉴팝업
		function allMenuPop(){
			try{ showCommonPopup('/advancement/jsp/common/allMenuPopup.jsp', '1050', '750'); }catch(e){}
		}
	
		//퇴직연금(DC) 간편조회 팝업
		function retireSimplePop(){
			try{ showCommonPopup('/hkp/hkp2010/p01.do', '720', '600'); }catch(e){}
		}
		
		//WTS 팝업 오픈
		function wtsOpen(){
			
				alert("로그인 이후 이용가능합니다.");return;
			
			window.open('/advancement/jsp/trading/wts.jsp','MiraeassetSecurities_WTS','width=1125,height=840,resizable=yes');
		}
		
		function openTalk(){
			window.open("https://securities.miraeasset.com/chat/chatting_qr.html", 'hka_talk', 'width=490,height=720,scrollbars=yes,location=0,status=0');
		}
		
		function doGnbLogin() {
		    if (isMobile()) {
		        openHp('/login.do?url=/main.do', false);
		    } else {
		        if (location.href.indexOf('wts') > -1) {
		            top.wtsFrame.location.href = '/login.do?url=' + encodeURI(location.href);
		            $("#topFrame", top.document).attr("rows", "0, 0, *, 0");
		        } else {
		            openHp('/login.do?url=/main.do', true);
		        }
		    }
		}
		
		//배너 클릭카운트 증가후 이동
		function eventBannerCtrl(areaCd, bnrCd, linkType, linkUrl){
			//console.log("areaCd["+areaCd+"], bnrCd["+bnrCd+"], linkType["+linkType+"], linkUrl["+linkUrl+"]");
			var params = {
				"areaCd" 	: areaCd,
				"bnrCd" 	: bnrCd
			};
			$.ajax({
				url 		: "/main/bannerViewCnt.json",	//호출페이지
				data		: params,
				dataType	: "json",
				type		: "POST",
				success		: function(data){
					linkTypeCtrl(linkType, linkUrl); //링크이동
				},
				error	: function(data, status, err){}
			});
			return false;
		}
		
		//링크유형별 이동 컨트롤러
		function linkTypeCtrl(linkType, linkUrl){
			if(linkUrl && linkUrl != ""){
				if(linkType == "D") 		openHp(linkUrl,false);			//메뉴이동
				else if(linkType == "N") 	window.open(linkUrl, '_blank');	//새창				
			}
		}
	// ]]>
	</script>
