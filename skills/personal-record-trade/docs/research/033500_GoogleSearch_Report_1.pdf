        <script type="text/javascript">
        //<![CDATA[
        $(document).ready(function(){
        	
        	$("ul.step1-tab").removeClass("step1-tab").addClass("step1-tbab_new");
        });
        
        var download = {};
        
        function downConfirm(url, name, width, height, scrollbars, resizable){
        	if($.cookies.get("research_down_confirm")!="Y"){
        		download.url=url;
        		download.name=name;
        		download.width=width;
        		download.height=height;
        		download.scrollbars=scrollbars;
        		download.resizable=resizable;
        		$('#downconfirm').show();
        	}else{
        		nv.Popup.open(url, name, width, height, scrollbars, resizable);
        	}    	
        }
        
        function confirmOpen(){
        	nv.Popup.open(download.url,download.name,download.width,download.height,download.scrollbars,download.resizable);
        	$('#downconfirm').hide();
        	if($('#today_close').is(":checked")){
        		$.cookies.set("research_down_confirm", "Y");
        	}
        }
        
        function confirmClose(){
        	download = {};
        	$('#downconfirm').hide();
        	if($('#today_close').is(":checked")){
        		$.cookies.set("research_down_confirm", "Y");
        	}
        }
        
        //]]>
        </script>
