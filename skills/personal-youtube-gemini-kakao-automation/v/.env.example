CHANNEL_URL=https://www.youtube.com/@YOUR_CHANNEL
TITLE_PREFIX=[체슬리모닝브리프]
GEMINI_GEM_URL=https://gemini.google.com/gem/YOUR_GEM_ID
SEND_TARGET=discord
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
KAKAO_TOKEN=
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_REDIRECT_URI=https://example.com
KAKAO_TOKEN_FILE=./kakao_token.json
PROCESSED_FILE=./processed.json
KAKAO_AUTH_CODE=
RUN_TIME=16:00

# Optional
PLAYWRIGHT_PROFILE_DIR=./chrome_profile
HEADLESS=false
TRANSCRIPT_LANGS=ko,ko-KR,en
RESPONSE_TIMEOUT_MS=120000
KAKAO_MAX_MESSAGE_LENGTH=1000
TRANSCRIPT_RETRY_INTERVAL_SEC=180
TRANSCRIPT_MAX_TRIES=10
GEMINI_INPUT_MAX_CHARS=8000
ONLY_WEEKDAYS=true
YT_NO_CHECK_CERTIFICATES=true
DISABLE_SSL_VERIFY=true
GEMINI_DEBUG_HOLD_MS=0

# Set 1 when you only want to save login session then exit
SETUP_LOGIN_ONLY=0
