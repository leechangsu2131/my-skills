# 이 파일을 .env 로 복사해 채운다. .env는 .gitignore에 있어 올라가지 않는다.
# 다른 위치에 두고 싶으면 ENV_FILE=경로 로 지정한다.

# --- 카카오 (기존 유튜브 자막 저장소와 같은 이름·같은 값) ---
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=

# --- 일정DB (내 구글 시트) ---
DB_SHEET_ID=
DB_TAB=일정DB
# 로컬에서는 키 파일 경로, 깃허브 액션에서는 JSON 전체를 GOOGLE_SERVICE_ACCOUNT_JSON Secret에
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- 원본 공용 시트 ('링크가 있는 모든 사용자 보기'로 공유된 시트) ---
# 시트 주소 .../d/<여기가 ID>/edit?gid=<여기가 gid>
SRC_WEEK_SHEET_ID=
SRC_WEEK_GID=0
SRC_TODAY_SHEET_ID=
SRC_TODAY_GID=0

# --- 선택 ---
# 오늘 일정표 '출장정보'에서 내 이름이 들어 있는 줄만 내 출장으로 가져온다
MY_NAME=
# 카톡 메시지의 버튼 링크 (비우면 일정DB 시트)
MESSAGE_LINK_URL=
# 보낼 일정이 하나도 없으면 발송을 건너뛰기: 1
SKIP_IF_EMPTY=
